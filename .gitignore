# ============================================================
# BltzNxt — .gitignore
# ============================================================

# ---- Build output ------------------------------------------
# CMake build directory (Zwischenartefakte, neu generierbar)
/build/

# Compiler-Binary und alle deploy-Dateien in bin/
# (blitzcc.exe, SDL3.dll, libgcc*.dll, test-Executables, ...)
/bin/

# ---- Toolchain ---------------------------------------------
# MinGW-Toolchain (re-installierbar via build_windows.bat / build_linux.sh)
/tools/

# ---- Libraries ---------------------------------------------
# SDL3 und weitere Drittanbieter-Binaries (re-downloadbar via build-Skripte)
/libs/

# ---- Test-Artefakte ----------------------------------------
# Kompilierte Test-Executables, generierte C++-Zwischendateien, Temp-Dateien
tests/*.exe
tests/*.dll
tests/*.cpp
tests/*.dat
tests/content.txt

# Testartefakte, die die Testsuite im Repo-Wurzelverzeichnis erzeugt
# (test_m45/m46 schreiben ihre PNG-Ausgabe ins CWD)
/__test_*.png

# ---- IDE & Editor ------------------------------------------
.vscode/
.idea/
*.suo
*.user
*.sln.docinfo

# ---- Windows -----------------------------------------------
Thumbs.db
desktop.ini

# ---- macOS -------------------------------------------------
.DS_Store

# ---- Sonstiges ---------------------------------------------
*.log
*.tmp
*.bak

# userlibs/ ist lokal (user-spezifische Libraries, nicht Teil des Repos)
/userlibs/

# src/libs/ content.txt ist nur ein Platzhalter
src/libs/content.txt

# Projektwebsite — extern gehostet auf bltznxt.com, nicht im Repo
/site/

# Claude AI — lokale Kontext- und Memory-Dateien
.claude/

# Internes Refactoring-Dokument (technische Schulden, nicht für Endnutzer)
/REFACTOR.md

# Internes Promotion-Dokument (Strategie, nicht für Endnutzer)
/promotion.md

# Interne Bug- und Review-Liste (Arbeitsdokument, nicht für Endnutzer)
/Buglist.md

# Interne Planungsdaten aus der ASTRA-Prüfung (Befunde, Szenario und die
# eigene Nachmessung dazu) — Arbeitsgrundlage, nicht für Endnutzer
/ASTRA_Findings.md
/ASTRA_Scenario.md
/ASTRA_Verifikation.md

# ============================================================
# Explizit NICHT ignoriert — auf GitHub sichtbar:
# ============================================================
# DEVLOG.md       — vollständige Entwicklungshistorie
# roadmap.md      — Milestone-Roadmap (M6–M70)
# src/compiler/   — Quellcode (Compiler + Runtime-Header)
# src/thirdparty/ — vendored Dependencies (nlohmann/json)
# tests/*.bb      — Testquellen (Blitz3D)
# tests/run_tests.sh
# tests/*.expected
# site/           — Projektwebsite
# CMakeLists.txt
# build_windows.bat / build_linux.sh
/OPUS_NOTES.md
