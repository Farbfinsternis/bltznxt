{
	"name": "bltznxt-ide",
	"version": "0.6.5",
	"main": "electron-main.js",
	"scripts": {
		"start": "electron .",
		"dev": "concurrently \"npm run vite\" \"npm run electron\"",
		"vite": "vite",
		"electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
		"build": "vite build",
		"test:smoke": "node test/smoke.js",
		"test": "node --test \"test/unit/**/*.test.js\"",
		"test:ui": "vite build && electron test/ui-smoke.js",
		"test:all": "npm test && npm run test:smoke && npm run test:ui"
	},
	"dependencies": {
		"electron": "^34.0.0",
		"monaco-editor": "^0.52.0"
	},
	"devDependencies": {
		"concurrently": "^9.0.0",
		"cross-env": "^7.0.3",
		"vite": "^6.0.0",
		"wait-on": "^8.0.5"
	}
}
