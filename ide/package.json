		"electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
		"build": "vite build"
	},
	"dependencies": {
		"electron": "^34.0.0",
		"monaco-editor": "^0.52.0"
	},
	"devDependencies": {
		"concurrently": "^9.0.0",
		"cross-env": "^7.0.3",
		"vite": "^6.0.0",
		"wait-on": "^8.0.5"
	}
}
